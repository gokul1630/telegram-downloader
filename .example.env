# Bot Environment
BOT_TOKEN="<your-bot-token>"
LOCAL_BOT_API_URL="http://127.0.0.1:8081"
BOT_API_DIR="./bot-api/"   # Directory path where the local Telegram Bot API files are stored
DOWNLOAD_TO_DIR="./downloads/"
USER_ID=1234567890         # Legacy single-user setting; USER_IDS can be used instead
USER_IDS=1234567890,9876543210  # Comma-separated allowed user IDs
CHAT_ID=1234567890         # Legacy single-chat setting; CHAT_IDS can be used instead
CHAT_IDS=1234567890,-1001234567890  # Comma-separated allowed chat IDs

# Local API Environment
TELEGRAM_API_ID=<your-telegram-api-id>
TELEGRAM_API_HASH="<your-telegram-api-hash>"
TELEGRAM_LOCAL=True
TELETHON_SESSION_PATH="./downloads/telethon_user"